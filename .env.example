# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional: override the default vision model.
# GEMINI_MODEL=gemini-flash-latest

# Optional: use a local Ollama vision model instead of Gemini (see PLAN.md §3).
# AI_PROVIDER=gemini            # gemini | ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5vl
