# Friday asks for your AI provider and key in the app on first launch, and
# stores the key encrypted in the macOS keychain. You do not need this file.
#
# It stays supported as a fallback for scripted setups and for people who
# already had one. A key saved in the app always wins over a key here.

# GEMINI_API_KEY=              # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=           # https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=              # https://platform.openai.com/api-keys

# Which provider to start with: gemini | ollama | claude | openai
# AI_PROVIDER=gemini

# Ollama runs locally and needs no key -- just a pulled vision model.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5vl

# Optional: a local whisper.cpp for voice. Required if you pick a provider
# that cannot transcribe audio (Claude, Ollama).
# WHISPER_BIN=
# WHISPER_MODEL=
